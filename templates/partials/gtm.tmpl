{{ define "gtm-head" }}
    <script>
        function hasUsageConsent() {
            var match = document.cookie.match(/ons_cookie_policy=([^;]+)/);
            if (!match) return false;
            try {
                var policy = JSON.parse(match[1].replace(/'/g, '"'));
                return policy.usage === true;
            } catch (e) {
                return false;
            }
        }

        if (hasUsageConsent()) {
            (function(w, d, s, l, i) {
                w[l] = w[l] || [];
                w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
                var f = d.getElementsByTagName(s)[0];
                var j = d.createElement(s);
                var dl = l !== "dataLayer" ? "&l=" + l : "";
                j.async = true;
                j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
                f.parentNode.insertBefore(j, f);
            })(window, document, "script", "dataLayer", "GTM-PBQ7KJ5B");
        }
    </script>
{{ end }}

